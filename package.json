{
  "name": "dsh-theme-mediascape",
  "version": "1.0.2",
  "description": "媒体景观主题 —— 动态媒体背景：立绘壁纸 + 霓虹配色 + 开屏动画 + 萤火粒子 + 背景音乐",
  "author": "EIGHTfs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/dsh-theme-mediascape.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "FAQ.md",
    "boot",
    "music",
    "wallpaper",
    "docs",
    "theme-studio"
  ],
  "scripts": {
    "prepack": "node build.cjs --clean"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "theme",
    "mediascape",
    "media"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT"
}
